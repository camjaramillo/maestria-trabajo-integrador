scale_fill_manual(values = colores_fuentes) +
scale_y_continuous(labels = scales::percent) +
labs(
#title = "Proporción del aporte de generación por hora y año",
x = "Hora del día",
y = "Proporción (%)",
fill = "Fuente"
) +
